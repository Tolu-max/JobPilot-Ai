{
  "manifest_version": 3,
  "name": "JobPilot Cookie Extractor",
  "version": "1.0",
  "description": "Extract cookies from job boards (LinkedIn, Glassdoor, Indeed) for JobPilot AI automation.",
  "permissions": ["cookies", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.glassdoor.com/*",
    "*://*.indeed.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
