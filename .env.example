# JobPilot environment configuration
# Copy this file to `.env` and fill in your own values.
# Public defaults are review-first and dry-run.

# AI provider: gemini | openrouter | groq
AI_PROVIDER=gemini
AI_MODE=REAL

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_PRO_MODEL=gemini-1.5-pro

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=JobPilot

# Groq
GROQ_API_KEY=

# Optional paid CAPTCHA solving
CAPSOLVER_API_KEY=
CAPTCHASOLV_API_KEY=
CAPTCHA_WAIT_MS=600000

# Profile and application defaults
PROFILE=main
APPLICANT_EMAIL=you@example.com
VOICE_RECORDING_URL=
AUTO_APPLY=false
TEST_MODE=true
NO_REAL_SUBMISSION=true
MAX_AUTO_APPLY_PER_RUN=1
MAX_JOBS_PER_RUN=20
GEMINI_MIN_LOCAL_SCORE=60
ALLOW_DUPLICATE_JOBS=false
ALLOW_GATEWAY_AUTO_SUBMIT=false
HEADLESS=true
ENABLED_SITES=remoteok,remotive,remotejobsorg
SITE_PRIORITY=remoteok,remotive,remotejobsorg

# Kill switch for every profile
KILL_SWITCH_DISABLE_AUTO_APPLY=false

# Per-profile overrides. Example for a profile named `sister`.
# SISTER_APPLICANT_EMAIL=sister@example.com
# SISTER_RESUME_PATH=./profiles/sister/resume.pdf
# SISTER_AUTO_APPLY=false
# SISTER_TEST_MODE=true
# SISTER_NO_REAL_SUBMISSION=true
# SISTER_MAX_AUTO_APPLY_PER_RUN=1
# SISTER_MAX_JOBS_PER_RUN=20
# SISTER_GEMINI_MIN_LOCAL_SCORE=60
# SISTER_ALLOW_GATEWAY_AUTO_SUBMIT=false
# SISTER_ENABLED_SITES=remoteok,remotive,remotejobsorg

# Scheduler
# Default is 4 hours. Private users can lower this after testing.
SCHEDULER_INTERVAL_MS=14400000

# Peak-hours throttling
PEAK_HOURS_ENABLED=false
PEAK_HOURS_START=08:00
PEAK_HOURS_END=20:00
PEAK_DAYS=1,2,3,4,5

# Telegram notifications
# Prefer: jobpilot telegram --profile=<name>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional inbox watcher
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Optional proxy
USE_FREE_PROXIES=false
PROXY_URL=

# Hosted/dashboard sync. Optional.
JOBPILOT_REQUIRE_AUTH=false
JOBPILOT_API_URL=http://localhost:4000
JOBPILOT_API_TIMEOUT_MS=15000
JOBPILOT_ALLOWED_ORIGINS=http://localhost:3000

# Supabase sync. For normal users, run `jobpilot login` and use anon envs.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role sync is advanced. Set a real auth.users UUID if you use it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_USER_ID=
SUPABASE_PROFILE_ID=

# Ports
API_PORT=4000
DASHBOARD_PORT=3000
JOBPILOT_LOCAL_DASHBOARD=false

# Dev / CI flags
RUN_BROWSER_TESTS=0
RUN_LIVE_SCRAPER_TESTS=0
E2E_TEST_MODE=false
TEST_PLATFORM_MODE=false
TEST_PLATFORM_MAX_JOBS_PER_SITE=5
TEST_PLATFORM_SCRAPE_MODE=
SCRAPER_LIMIT=
HEALTH_MAX_JOBS=10
HEALTH_TIMEOUT_MS=60000
